#!/bin/sh
# Sourced by bin/exnode before it starts the VM.

# UTF-8 file names whatever the locale (Elixir warns under a C/POSIX one).
ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-+fnu}"
export ELIXIR_ERL_OPTIONS

# Distribution is off unless asked for: bin/exnoded runs the node through
# `eval`, which never starts it anyway.
RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
export RELEASE_DISTRIBUTION

# The release ships no cookie (mix.exs). Without RELEASE_COOKIE or a
# releases/COOKIE file, use a random one per run: `remote` and `rpc` then
# need RELEASE_COOKIE set to the same value on both sides.
if [ -z "$RELEASE_COOKIE" ] && [ ! -f "$RELEASE_ROOT/releases/COOKIE" ]; then
  RELEASE_COOKIE="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
  export RELEASE_COOKIE
fi
